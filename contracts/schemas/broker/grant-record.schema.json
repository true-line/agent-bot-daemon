{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grant record",
  "description": "0.4 Appendix A: grant ID, issuer, principal, Soul, member or role scope, runtime binding, epoch, action and resource selectors, allowed destinations, data restrictions, budget, expiry, revocation version. Stored at HQ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "issuer",
    "principal",
    "soul_id",
    "member_or_role",
    "epoch",
    "actions",
    "resources",
    "allowed_destinations",
    "data_restrictions",
    "budget",
    "expiry",
    "revocation_version"
  ],
  "properties": {
    "grant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "issuer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "principal": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "soul_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "member_or_role": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "member_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
      }
    },
    "runtime_binding": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "epoch": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "allowed_destinations": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.:-]{0,127}$" }
    },
    "data_restrictions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "notes": { "type": "string", "maxLength": 512 }
      }
    },
    "budget": { "type": "number", "minimum": 0 },
    "expiry": { "type": "string", "format": "date-time" },
    "revocation_version": { "type": "integer", "minimum": 0 }
  }
}
