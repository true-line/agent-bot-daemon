{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hq/v1 Ready and lease renewal",
  "description": "0.4 Appendix A: runtime ID, installation epoch, readiness state, adapter versions, lease generation, renewal sequence, observed health. HQ derives the caller, rejects replay, and returns the authoritative expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_id",
    "installation_epoch",
    "readiness_state",
    "adapter_versions",
    "lease_generation",
    "renewal_sequence",
    "observed_health"
  ],
  "properties": {
    "runtime_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "installation_epoch": { "type": "integer", "minimum": 0 },
    "readiness_state": { "type": "string", "enum": ["warm", "cold"] },
    "adapter_versions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "renewal_sequence": { "type": "integer", "minimum": 1 },
    "observed_health": { "type": "string", "enum": ["healthy", "degraded", "unreachable"] }
  }
}
