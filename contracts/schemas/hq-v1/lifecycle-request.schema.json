{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hq/v1 Lifecycle request",
  "description": "0.4 Appendix A: request ID, operation, target installation, expected state revision, reason, deadline, owner session reference. HQ authenticates the local caller and returns a decision and resulting state. Recovery is not an hq/v1 operation (0.4 §5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "operation",
    "target_installation_id",
    "expected_state_revision",
    "reason",
    "owner_session_reference"
  ],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "operation": {
      "type": "string",
      "enum": [
        "start",
        "stop",
        "pause",
        "resume",
        "drain",
        "sleep",
        "move",
        "fork",
        "accept-revision",
        "rollback-revision",
        "retire"
      ]
    },
    "target_installation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "expected_state_revision": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "deadline": { "type": "string", "format": "date-time" },
    "owner_session_reference": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" }
  }
}
