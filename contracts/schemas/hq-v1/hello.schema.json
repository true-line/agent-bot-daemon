{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hq/v1 Hello (admission request)",
  "description": "0.4 Appendix A: contract version, request ID, Soul ID, definition digest, installation ID, prior installation epoch on move, supported capabilities, requested roles. HQ rejects an unaccepted definition or an unsupported profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "soul_id",
    "definition_digest",
    "installation_id",
    "supported_capabilities",
    "requested_roles"
  ],
  "properties": {
    "contract_version": { "type": "integer", "minimum": 1 },
    "request_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "soul_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "definition_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "installation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "prior_installation_epoch": { "type": "integer", "minimum": 0, "description": "Present only on a move: the epoch the sender last held." },
    "supported_capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "uniqueItems": true
    },
    "requested_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
    }
  }
}
